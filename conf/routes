# conf/routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/JavaRouting

# Home page: just the search form, no results yet.
GET     /                           controllers.MastodonController.index(request: Request)

# Main search action. hashtag is required; maxId is optional and is how we
# support "Load More" pagination (assignment 5.1) without re-fetching page 1.
GET     /search                     controllers.MastodonController.search(request: Request, hashtag: String ?= "", maxId: java.util.Optional[String])

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
